{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "prepare runtime",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/env.sh"
      ],
      "problemMatcher": []
    },
    {
      "label": "wait for GR00T",
      "dependsOn": "prepare runtime",
      "type": "process",
      "command": "${workspaceFolder}/.venvs/groot/bin/python",
      "args": [
        "${workspaceFolder}/third_party/IsaacLab-Arena/isaaclab_arena_gr00t/utils/wait_for_gr00t_server.py",
        "--host",
        "127.0.0.1",
        "--port",
        "5555",
        "--timeout-sec",
        "600",
        "--poll-interval-sec",
        "5",
        "--request-timeout-ms",
        "5000"
      ],
      "options": {
        "cwd": "${workspaceFolder}/third_party/IsaacLab-Arena/submodules/Isaac-GR00T"
      },
      "problemMatcher": []
    }
  ]
}
